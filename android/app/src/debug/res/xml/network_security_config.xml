<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config.

  During development, Metro bundler runs over plain HTTP on the host
  machine, so we need to permit cleartext for these dev-time hosts:
    • localhost / 127.0.0.1  — iOS simulator / adb reverse
    • 10.0.2.2                — Android emulator → host loopback
    • 10.0.3.2                — Genymotion → host loopback
    • 139.5.6.137             — current NHM backend (still HTTP)

  This file lives under `src/debug/` so it is NEVER packaged into a
  release APK. Release builds pick up the stricter config from
  `src/main/res/xml/network_security_config.xml`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
        <domain includeSubdomains="true">139.5.6.137</domain>
    </domain-config>
</network-security-config>
