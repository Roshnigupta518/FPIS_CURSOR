<?xml version="1.0" encoding="utf-8"?>
<!--
  NHM SAST hardening — Cleartext Traffic + backend TLS bridge
  ===========================================================
  1. Cleartext HTTP is DENIED globally (base-config). This closes the
     SAST finding CWE-319 flagged in `AndroidManifest.xml`.

  2. For the NHM backend at 139.5.6.137 we pin its exact self-signed
     certificate as a scoped trust anchor (res/raw/nhm_server.pem).
     Only that one certificate is accepted for this host — every other
     TLS connection still goes through the system CA store.

     NOTE: this file alone cannot bypass Android's hostname verification
     (the cert has CN=localhost but URL host is 139.5.6.137). That side
     of the bridge lives in Kotlin at
     com.familywelfareapp.net.NhmSslClientFactory.

  TODO (remove this whole bridge once backend serves a proper CA-signed
  certificate whose SAN matches the URL host):
    • Delete the <domain-config> block below.
    • Delete android/app/src/main/res/raw/nhm_server.pem.
    • Delete com/familywelfareapp/net/NhmSslClientFactory.kt.
    • Delete the NhmSslClientFactory.register(...) call from
      MainApplication.onCreate().
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">139.5.6.137</domain>
        <trust-anchors>
            <certificates src="@raw/nhm_server" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
